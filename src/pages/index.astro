---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseCard from "../../components/CaseCard.astro";
const cases = (await getCollection("cases")).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Case Studies｜杨两只" description="品牌故事、内容策略与产品叙事案例。">
  <div class="page-shell">
    <section class="page-intro"><p class="eyebrow">Portfolio · 2023—Now</p><div><h1 class="display">Case Studies</h1><p class="intro-copy">品牌故事、内容策略与产品叙事案例。每一个项目，都从理解品牌真正想说什么开始。</p></div></section>
    <section class="section"><div class="case-grid">{cases.map((entry, index) => <CaseCard entry={entry} index={index} />)}</div></section>
  </div>
</BaseLayout>
