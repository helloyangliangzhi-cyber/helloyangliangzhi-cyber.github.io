---
import BaseLayout from "../layouts/BaseLayout.astro";
const services: Array<[string, string, string[]]> = [
  ["01", "品牌策略与叙事", ["品牌定位与核心主张", "品牌故事", "品牌手册与产品命名"]],
  ["02", "品牌内容建设", ["社媒内容策略", "内容栏目规划", "长期内容顾问"]],
  ["03", "创意概念与项目策划", ["创意主题与概念", "项目故事线", "传播及线下体验内容"]],
  ["04", "产品与包装叙事", ["产品概念与故事", "包装创意与文案", "详情页与视频脚本"]],
  ["05", "展览与空间内容", ["展览内容结构", "展览前言与单元文案", "建筑与空间项目叙事"]],
];
---
<BaseLayout title="Services｜杨两只｜无限袤 MAU Studio" description="提供品牌策略与叙事、品牌内容建设、创意概念、产品与包装叙事，以及展览与空间内容服务。">
  <div class="page-shell">
    <section class="page-intro"><p class="eyebrow">Services</p><div><h1 class="display">从想法出发，<br />让创意落地。</h1><p class="intro-copy">无限袤 MAU Studio 由杨两只主导，从研究、策略与文字出发，为品牌建立清晰的故事、内容与创意方向；并根据项目需要，与设计师及不同领域的伙伴协作完成落地。</p></div></section>
    <section class="section">{services.map(([num, title, items]) => <article class="service-detail"><span class="num">{num}</span><h2>{title}</h2><ul>{items.map((item) => <li>{item}</li>)}</ul></article>)}</section>
    <section class="section checkup-section" id="brand-checkup">
      <div class="checkup-intro">
        <p class="eyebrow">Brand Expression Check-up</p>
        <div>
          <h2>45 分钟<br />品牌表达体检</h2>
          <p>如果你已经意识到品牌的表达有些问题，却暂时说不清问题在哪里，我们可以先从一次聚焦的对话开始。</p>
        </div>
      </div>
      <div class="checkup-detail">
        <p class="checkup-lead">围绕一个当下最需要解决的品牌语言问题，判断表达中的卡点、梳理优先级，并给出下一步可以行动的方向。</p>
        <div class="checkup-points">
          <div><span>01</span><p>适合品牌主理人、内容负责人，以及正在重新梳理品牌表达的团队。</p></div>
          <div><span>02</span><p>可以讨论品牌介绍、品牌故事、产品表达或社媒内容方向中的具体问题。</p></div>
          <div><span>03</span><p>这是一次微型诊断，适合先确认问题；如需完整策略与文案，可再进入项目合作。</p></div>
        </div>
        <a class="button" href="https://xhslink.com/m/3gzbUEHAzhs" target="_blank" rel="noreferrer">在小红书查看并预约 ↗</a>
      </div>
    </section>
    <section class="section"><div class="section-head"><p class="eyebrow">How We Work</p><h2>研究、定义、<br />让它发生。</h2></div><div class="method-grid"><article class="method-item"><span>01</span><h3>理解与研究</h3><p>从项目背景、目标、文化语境与用户出发，理解品牌真正需要解决的问题。</p></article><article class="method-item"><span>02</span><h3>定义核心方向</h3><p>提炼值得表达的核心，建立策略、创意概念与内容结构，并在关键节点保持同步。</p></article><article class="method-item"><span>03</span><h3>协作与落地</h3><p>完成文字与内容交付；如项目涉及视觉及其他专业执行，则与合适的创作伙伴共同完成，并清晰注明分工。</p></article></div></section>
    <section class="section faq-section">
      <div class="section-head"><p class="eyebrow">FAQ</p><h2>合作常见问题</h2></div>
      <div class="faq-list">
        <details open>
          <summary><span>01</span><h3>如何开始合作？</h3></summary>
          <p>你可以通过邮件、微信或小红书，简单说明品牌或项目背景、目前希望解决的问题，以及大致时间安排。我会先了解需求，再与你确认合作范围、交付内容与项目节奏。</p>
        </details>
        <details>
          <summary><span>02</span><h3>项目如何收费？</h3></summary>
          <p>费用会根据项目目标、工作范围、交付内容与合作周期综合评估，完整项目通常从人民币 10,000 元起。沟通需求后会提供具体报价，并在开始前确认交付范围、时间节点与修改方式。如果暂时不确定是否需要完整项目，也可以先从 45 分钟的品牌表达体检开始。</p>
        </details>
        <details>
          <summary><span>03</span><h3>如何签约与沟通？</h3></summary>
          <p>支持全国及海外线上沟通，并可通过电子合同完成签约。我常驻上海，如项目需要，也可以根据双方时间安排当面沟通。合作过程会在关键节点同步方向与反馈。</p>
        </details>
      </div>
    </section>
  </div>
</BaseLayout>
