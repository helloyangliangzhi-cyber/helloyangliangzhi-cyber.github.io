---
import BaseLayout from "../layouts/BaseLayout.astro";
const services: Array<[string, string, string[]]> = [
  ["01", "品牌策略与故事", ["品牌故事", "品牌价值梳理", "品牌手册"]],
  ["02", "品牌内容建设", ["社媒内容策略", "内容栏目规划", "长期内容顾问"]],
  ["03", "产品叙事", ["产品故事", "产品详情页", "视频脚本"]],
  ["04", "建筑与空间叙事", ["设计理念梳理", "建筑与空间项目文案", "媒体发布内容"]],
];
---
<BaseLayout title="Services｜杨两只" description="品牌策略与故事、品牌内容建设、产品叙事及建筑与空间叙事服务。">
  <div class="page-shell">
    <section class="page-intro"><p class="eyebrow">Services</p><div><h1 class="display">帮助品牌，<br />表达得更清楚。</h1><p class="intro-copy">以独立顾问的方式参与品牌项目：从理解、提炼到表达，提供可持续的内容方向，而不只是一次性的文案。</p></div></section>
    <section class="section">{services.map(([num, title, items]) => <article class="service-detail"><span class="num">{num}</span><h2>{title}</h2><ul>{items.map((item) => <li>{item}</li>)}</ul></article>)}</section>
    <section class="section"><div class="section-head"><p class="eyebrow">How We Work</p><h2>清晰、具体、<br />保持对话。</h2></div><div class="method-grid"><article class="method-item"><span>01</span><h3>理解问题</h3><p>从项目背景、目标与现有内容出发，明确品牌真正需要解决的问题。</p></article><article class="method-item"><span>02</span><h3>共同建立方向</h3><p>通过研究与讨论确定内容框架，在关键节点与你保持同步。</p></article><article class="method-item"><span>03</span><h3>形成可用表达</h3><p>交付清晰、可落地的文字与内容，并为长期使用预留延展空间。</p></article></div></section>
  </div>
</BaseLayout>
