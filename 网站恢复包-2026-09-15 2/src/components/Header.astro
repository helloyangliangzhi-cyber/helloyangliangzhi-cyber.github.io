---
const pathname = Astro.url.pathname;
const links = [
  ["/cases/", "Cases"],
  ["/services/", "Services"],
  ["/about/", "About"],
  ["/contact/", "Contact"],
];
---

<header class="header">
  <a class="wordmark" href="/" aria-label="杨两只首页">
    <strong>杨两只</strong><span>无限袤 MAU Studio · Brand &amp; Creative Studio</span>
  </a>
  <nav aria-label="主导航">
    {links.map(([href, label]) => (
      <a href={href} class:list={{ active: pathname.startsWith(href) }}>{label}</a>
    ))}
  </nav>
</header>

